{
  "name": "educonnect-ai",
  "version": "0.1.0",
  "private": true,
  "description": "EduConnect AI web application",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,green \"python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload\" \"vite frontend --config frontend/vite.config.ts --host 0.0.0.0 --port 5000 --strictPort\"",
    "build": "tsc -p frontend/tsconfig.json && vite build frontend --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "python -m unittest discover -s backend/tests",
    "start:prod": "npm run build && NODE_ENV=production tsx server/index.ts",
    "db:current": "python -m alembic current",
    "db:upgrade": "python -m alembic upgrade head",
    "db:revision": "python -m alembic revision --autogenerate"
  },
  "type": "module",
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@clerk/react": "^6.17.5",
    "@clerk/shared": "^4.38.0",
    "@clerk/themes": "^2.4.57",
    "@tanstack/react-query": "^5.104.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wouter": "^3.13.0"
  }
}
